---
import { getImage } from 'astro:assets';
import '@fontsource/ubuntu/latin-400.css';
import '@fontsource/ubuntu/latin-500.css';
import '@fontsource/ubuntu/latin-700.css';
import '@fontsource/love-ya-like-a-sister/latin-400.css';
import '../styles/global.css';
import { site } from '../data/home';
const socialImage = await getImage({ src: site.hero, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---
<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFBF5" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:site_name" content="Explauradise" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={new URL(socialImage.src, Astro.site)} />
    <meta property="og:image:alt" content={site.heroAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Ga naar inhoud</a>
    <slot />
  </body>
</html>
